<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.interviewcopilot</groupId>
  <artifactId>interview-copilot</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>InterviewCopilot</name>
  <description>Java 八股面试拷打助手：RAG 知识库问答 + 面试模拟评分</description>

  <properties>
    <java.version>21</java.version>
    <langchain4j.version>1.23.0</langchain4j.version>
    <langchain4j-embeddings.version>1.23.0-beta33</langchain4j-embeddings.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- LLM 接入: DeepSeek 官方 API 兼容 OpenAI 协议, 用 openai 客户端直连 -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-open-ai</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>

    <!-- AiServices 声明式助手 / RAG 管线 / 聊天记忆 / 内存向量库 -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
      <version>${langchain4j.version}</version>
    </dependency>

    <!-- 中文向量化: 进程内 ONNX 模型, 零 key 零部署, 构成"本地向量化"那一半 -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-embeddings-bge-small-zh-v15</artifactId>
      <version>${langchain4j-embeddings.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
